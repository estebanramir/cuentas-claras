# React Native y el autolinking de Expo esperan un node_modules plano. Con el
# enlazado estricto de pnpm, Metro no encuentra dependencias que los paquetes
# declaran como peer, y el error que da apunta al archivo equivocado.
shamefully-hoist=true
node-linker=hoisted

# Cambiar de enlazador obliga a pnpm a recrear node_modules; sin TTY se aborta.
confirmModulesPurge=false
