# --- Base de datos ---
# En produccion las inyecta la integracion de Neon en Vercel, no hay que
# copiarlas a mano. Estas son solo para desarrollo local.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"

# --- Sesion ---
# Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Google Sign-In ---
# El client id WEB del proyecto de Google Cloud. La app pide el idToken con
# este mismo id, y la API valida contra el que el token declara como audiencia.
GOOGLE_WEB_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"

# --- Cron ---
# Generar con: openssl rand -hex 32
CRON_SECRET="cambiar-por-un-secreto-aleatorio"
