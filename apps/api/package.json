{
  "name": "@cuentas/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate --schema=../../packages/db/prisma/schema.prisma && prisma migrate deploy --schema=../../packages/db/prisma/schema.prisma && next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@cuentas/db": "workspace:*",
    "@cuentas/shared": "workspace:*",
    "google-auth-library": "^9.15.1",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  }
}
